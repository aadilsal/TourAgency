# Next.js (public)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Canonical production origin, no trailing slash (e.g. https://www.junkettours.co).
# Drives metadataBase, canonical URLs, sitemap.xml, robots.txt and JSON-LD —
# must be the real domain in production or SEO tags will point elsewhere.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Email (Convex actions)
RESEND_API_KEY=
RESEND_FROM=JunketTours <bookings@yourdomain.com>
ADMIN_NOTIFICATION_EMAIL=you@yourdomain.com
APP_BASE_URL=https://your-app.vercel.app

# AI (Convex actions)
GROQ_API_KEY=

# Google Places reviews (Convex action + daily cron). Set the API key and the
# homepage testimonials switch to live Google reviews (up to 5 — a Google API
# limit, not ours); otherwise curated ones show. The Place ID auto-resolves
# from the business name + office address in Settings — only set
# GOOGLE_PLACE_ID manually if auto-detection ever picks the wrong listing.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# One-time bootstrap (Convex action bootstrapSuperAdmin), then remove
BOOTSTRAP_SECRET=

# Optional: shown in footer (display string, e.g. +92 300 1234567)
NEXT_PUBLIC_CONTACT_PHONE=

# Footer map: Google Maps embed src URL + human-readable address line
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_OFFICE_ADDRESS=

# WhatsApp click-to-chat (optional; defaults to +923209973486 if unset)
WHATSAPP_BUSINESS_NUMBER=

# --- Analytics & SEO -------------------------------------------------------
# Google Analytics 4 Measurement ID (format G-XXXXXXXXXX). GA4 only loads after
# a visitor clicks "Accept all" on the cookie banner (Consent Mode v2).
# Leave empty to disable GA4. Vercel Web Analytics + Speed Insights need no
# env var — enable them in the Vercel project dashboard.
NEXT_PUBLIC_GA4_ID=
# Optional: "advanced" loads gtag.js before consent with all storage denied
# (cookieless pings enable GA4 conversion modelling). Default/empty = basic
# mode (nothing loads until consent). Get legal sign-off before enabling.
NEXT_PUBLIC_GA_CONSENT_MODE=
# Google Search Console HTML-tag verification token — just the content value
# of <meta name="google-site-verification" content="...">.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
